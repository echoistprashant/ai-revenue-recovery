# Optional local configuration. These are non-secret defaults — never commit a
# real .env, and never put a production secret in this file.

# --- Storage -----------------------------------------------------------------
# SQLite path used when DATABASE_URL is empty (local dev, tests, CI).
REVENUE_RECOVERY_DATABASE=data/revenue_recovery.db
# Set to run on PostgreSQL instead. Both spellings are accepted and normalized
# to the psycopg driver. Apply migrations first: `alembic upgrade head`.
# DATABASE_URL=postgresql+psycopg://revenue:CHANGE_ME@localhost:5432/revenue_recovery

# --- Services ----------------------------------------------------------------
REVENUE_RECOVERY_API_URL=http://127.0.0.1:8000
RECOVERY_MODEL_PATH=models/recovery_model.joblib
APP_ENVIRONMENT=development

# --- Background execution ----------------------------------------------------
# inline: the ingesting request executes the approved action (default; the
#   synthetic baselines depend on it).
# queued: the action is written to the tasks table and executed by
#   `python scripts/run_worker.py`, so a delayed retry survives a restart.
TASK_EXECUTION_MODE=inline
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=5.0
WORKER_BATCH_SIZE=20

# --- Authentication and access control ---------------------------------------
# Signs access tokens (HS256). Leave empty in development: a random ephemeral key
# is generated per process, so tokens simply stop working when the API restarts.
# In production the API refuses to boot without one of at least 32 characters —
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Supply the real value through the deployment's secret store, never this file.
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# How long a signed-in session lasts. Tokens are stateless, so shortening this is
# the main lever on how long a stolen token stays usable; a deactivated account is
# refused immediately regardless, because the account row is re-read per request.
ACCESS_TOKEN_TTL_MINUTES=60
# Fixed-window request budgets, per client, per minute. The login limiter is
# separate and much tighter because it is the one route worth guessing against.
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Refuse plain-HTTP requests (403, not a redirect — a redirect would already have
# carried the bearer token in clear text). Defaults to on in production.
# ENFORCE_HTTPS=true
# Tenant assigned to accounts and to gateway webhooks, which carry no tenant of
# their own. All queries are scoped by tenant.
DEFAULT_TENANT=default

# --- Secrets (placeholders only) ---------------------------------------------
# Simulation default. Replace with the real signing secret when connecting a live
# Razorpay account, and supply it through the deployment's secret store.
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret

# --- docker compose --profile postgres ---------------------------------------
# POSTGRES_PASSWORD has no default; compose refuses to start without it.
# POSTGRES_DB=revenue_recovery
# POSTGRES_USER=revenue
# POSTGRES_PASSWORD=CHANGE_ME
