# Optional local configuration. These are non-secret defaults — never commit a
# real .env, and never put a production secret in this file.

# --- Storage -----------------------------------------------------------------
# SQLite path used when DATABASE_URL is empty (local dev, tests, CI).
REVENUE_RECOVERY_DATABASE=data/revenue_recovery.db
# Set to run on PostgreSQL instead. Both spellings are accepted and normalized
# to the psycopg driver. Apply migrations first: `alembic upgrade head`.
# DATABASE_URL=postgresql+psycopg://revenue:CHANGE_ME@localhost:5432/revenue_recovery

# --- Services ----------------------------------------------------------------
REVENUE_RECOVERY_API_URL=http://127.0.0.1:8000
RECOVERY_MODEL_PATH=models/recovery_model.joblib
APP_ENVIRONMENT=development

# --- Background execution ----------------------------------------------------
# inline: the ingesting request executes the approved action (default; the
#   synthetic baselines depend on it).
# queued: the action is written to the tasks table and executed by
#   `python scripts/run_worker.py`, so a delayed retry survives a restart.
TASK_EXECUTION_MODE=inline
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=5.0
WORKER_BATCH_SIZE=20

# --- Authentication and access control ---------------------------------------
# Signs access tokens (HS256). Leave empty in development: a random ephemeral key
# is generated per process, so tokens simply stop working when the API restarts.
# In production the API refuses to boot without one of at least 32 characters —
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Supply the real value through the deployment's secret store, never this file.
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# How long a signed-in session lasts. Tokens are stateless, so shortening this is
# the main lever on how long a stolen token stays usable; a deactivated account is
# refused immediately regardless, because the account row is re-read per request.
ACCESS_TOKEN_TTL_MINUTES=60
# Fixed-window request budgets, per client, per minute. The login limiter is
# separate and much tighter because it is the one route worth guessing against.
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Refuse plain-HTTP requests (403, not a redirect — a redirect would already have
# carried the bearer token in clear text). Defaults to on in production.
# ENFORCE_HTTPS=true
# Tenant assigned to accounts and to gateway webhooks, which carry no tenant of
# their own. All queries are scoped by tenant.
DEFAULT_TENANT=default

# --- Observability -----------------------------------------------------------
# Empty leaves the host application's logging configuration alone, which is what
# tests, scripts, and an interactive shell want. `json` installs one JSON object
# per line with the structured fields each call site attaches. Production defaults
# to json without this being set. Only process entry points read it.
LOG_FORMAT=
LOG_LEVEL=INFO

# --- Secrets (placeholders only) ---------------------------------------------
# Simulation default, and a publicly published one: it is in this file, in the
# README, and in the test suite. The API therefore REFUSES TO BOOT with this value
# when APP_ENVIRONMENT=production — a startup failure an operator sees, rather than
# a 401 discovered in live traffic. Copy the real secret out of the Razorpay
# dashboard (Settings -> Webhooks) and supply it through the deployment's secret
# store, never through this file.
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret
# How far a webhook delivery's own signed `created_at` may sit from this server's
# clock, in seconds, in either direction. Razorpay sends no timestamp header, so
# this is checked against the epoch inside the signed body. A signature proves
# origin, not freshness: without this bound, one captured delivery stays replayable
# forever. Widen only if the deployment's clock skew genuinely demands it.
WEBHOOK_TOLERANCE_SECONDS=300

# --- Next.js control centre (frontend/) --------------------------------------
# The frontend keeps the API token in an httpOnly cookie and never exposes it to
# browser JavaScript. Secure defaults to on; set false only for local http://
# development, where a Secure cookie is silently dropped. Never false in production.
FRONTEND_COOKIE_SECURE=true
# How long a frontend route handler waits on the API before giving up.
BACKEND_TIMEOUT_MS=15000

# --- Outbound Channels (Retell AI, Vomyra AI, & Twilio WhatsApp) --------------
# Retell AI Voice Call (https://retellai.com - Recommended)
# VOICE_PROVIDER=retell
# RETELL_API_KEY=
# RETELL_AGENT_ID=
# RETELL_FROM_NUMBER=+12135551234
# RETELL_FALLBACK_PHONE=+919876543210

# Vomyra AI / Bolna AI Voice Call (Alternative)
# VOMYRA_API_KEY=
# VOMYRA_AGENT_ID=
# VOMYRA_API_URL=https://api.vomyra.ai/v1/calls
# VOMYRA_FALLBACK_PHONE=+919876543210


# Vapi AI Voice Call (Alternative)
# VAPI_API_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=
# VAPI_FALLBACK_PHONE=+919876543210

# Twilio WhatsApp Sandbox (https://twilio.com - Free Trial)
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# --- docker compose --profile postgres ---------------------------------------
# POSTGRES_PASSWORD has no default; compose refuses to start without it.
# POSTGRES_DB=revenue_recovery
# POSTGRES_USER=revenue
# POSTGRES_PASSWORD=CHANGE_ME

